# Required for hybrid persistence and auth
DATABASE_URL=postgres://postgres:postgres@localhost:5432/portafolio
AUTH_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Bootstrap admin (forced password change on first login)
AUTH_BOOTSTRAP_ADMIN_USER=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=password
AUTH_BOOTSTRAP_ADMIN_NAME=Administrador
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@tu-dominio.com
APP_URL=http://localhost:3000

# Optional (email notifications)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Portafolio <no-reply@tu-dominio.com>
